# Linux/macOS: export HELIOS_ADMIN_API_KEY='your-long-random-secret'
# Windows PowerShell: $env:HELIOS_ADMIN_API_KEY='your-long-random-secret'
HELIOS_ADMIN_API_KEY=replace-with-a-long-random-local-secret
HELIOS_DATA_DIR=runtime
HELIOS_AUTO_MONITOR=true
HELIOS_MONITOR_INTERVAL_SECONDS=60
HELIOS_MONITOR_WINDOW=100
HELIOS_MIN_DRIFT_SAMPLES=30
HELIOS_DRIFT_PSI_THRESHOLD=0.25
HELIOS_MIN_FEEDBACK_SAMPLES=20
HELIOS_ACCURACY_ALERT_THRESHOLD=0.85
HELIOS_CANDIDATE_ACCURACY_THRESHOLD=0.90
HELIOS_MIN_FRAUD_RECALL=0.65
HELIOS_MAX_ALLOWED_REGRESSION=0.03
HELIOS_LATENCY_ALERT_MS=500
HELIOS_ACTION_COOLDOWN_SECONDS=300
HELIOS_DEMO_MODE=false
# If installed with requirements-mlflow.txt, optionally set a real MLflow URI:
# HELIOS_MLFLOW_TRACKING_URI=http://localhost:5000
